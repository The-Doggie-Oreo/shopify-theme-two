{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title",
          "settings": {}
        },
        "rating": {
          "type": "rating",
          "settings": {}
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector",
          "settings": {}
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": false
          }
        },
        "trust_icons": {
          "type": "icon-with-text",
          "settings": {
            "layout": "horizontal",
            "icon_1": "check_mark",
            "heading_1": "Made to order",
            "icon_2": "truck",
            "heading_2": "Packed in the shop",
            "icon_3": "heart",
            "heading_3": "Custom colors available"
          }
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "materials": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Materials and finish",
            "icon": "leather",
            "content": "<p>Printed in high-grade PLA or PETG, depending on the piece. Supports are removed, surfaces are cleaned up, and moving parts are checked before packing.</p>",
            "page": ""
          }
        },
        "printing": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "How it’s printed",
            "icon": "ruler",
            "content": "<p>Each order is sliced for this product, printed on enclosed machines, and finished in the shop. Multi-color jobs use AMS so the piece comes off the plate in color.</p>",
            "page": ""
          }
        },
        "custom": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Custom names, logos, and colors",
            "icon": "clipboard",
            "content": "<p>Need different text, a league logo, or another colorway? Use Contact and send the details. If it can be printed well, it can be built here.</p>",
            "page": ""
          }
        },
        "shipping": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Lead time and shipping",
            "icon": "truck",
            "content": "<p>These are made to order. Typical shop time is a few days, then the piece is packed and shipped. You’ll get tracking when it goes out.</p>",
            "page": ""
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "rating",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "trust_icons",
        "description",
        "materials",
        "printing",
        "custom",
        "shipping"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "gallery_layout": "thumbnail",
        "mobile_thumbnails": "show",
        "media_position": "left",
        "image_zoom": "lightbox",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 20
      }
    },
    "details": {
      "type": "product-details",
      "settings": {
        "heading": "Take a closer look",
        "heading_size": "h1",
        "color_scheme": "scheme-2",
        "padding_top": 56,
        "padding_bottom": 72
      }
    },
    "custom_cta": {
      "type": "rich-text",
      "blocks": {
        "caption": {
          "type": "caption",
          "settings": {
            "caption": "Want it different?",
            "text_style": "caption-with-letter-spacing",
            "text_size": "medium"
          }
        },
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Need a custom version of this piece?",
            "heading_size": "h1"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Send the name, logo, or color and we’ll print it to match.</p>"
          }
        },
        "button": {
          "type": "button",
          "settings": {
            "button_label": "Start a custom order",
            "button_link": "shopify://pages/contact",
            "button_style_secondary": false,
            "button_label_2": "",
            "button_link_2": "",
            "button_style_secondary_2": false
          }
        }
      },
      "block_order": ["caption", "heading", "text", "button"],
      "settings": {
        "desktop_content_position": "center",
        "content_alignment": "center",
        "color_scheme": "scheme-5",
        "full_width": true,
        "padding_top": 64,
        "padding_bottom": 64
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "More from the shop",
        "heading_size": "h1",
        "products_to_show": 3,
        "columns_desktop": 3,
        "columns_mobile": "2",
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": true,
        "padding_top": 48,
        "padding_bottom": 64
      }
    }
  },
  "order": [
    "main",
    "details",
    "custom_cta",
    "related-products"
  ]
}
