<div class="kg-about-wrapper">
  <!-- Hero Section -->
  <section class="kg-hero">
    <div class="kg-container">
      <span class="kg-badge">Digital Fabrication & Additive Manufacturing</span>
      <h1 class="kg-title">Precision Engineering Meets Functional Design</h1>
      <p class="kg-subtitle">
        At Kinetic Grid 3D, we specialize in high-detail custom awards, bespoke trophies, and print-on-demand 3D models engineered with precision tolerances and multi-material finishes.
      </p>
    </div>
  </section>

  <!-- Capability Pillars -->
  <section class="kg-pillars">
    <div class="kg-container">
      <div class="kg-grid-3">
        <div class="kg-card">
          <div class="kg-icon">🏆</div>
          <h3>Custom Trophies & Awards</h3>
          <p>End-to-end design, multi-color 3D printing, and laser-engraved plaques crafted specifically for tournaments, corporate honors, and local leagues.</p>
        </div>

        <div class="kg-card">
          <div class="kg-icon">⚙️</div>
          <h3>Multi-Material Manufacturing</h3>
          <p>Utilizing Automated Material Systems (AMS) and multi-axis printing to deliver durable, vibrant, and multi-color components straight off the build plate.</p>
        </div>

        <div class="kg-card">
          <div class="kg-icon">📐</div>
          <h3>On-Demand Catalog</h3>
          <p>A growing library of tabletop gaming essentials, precision organizers, and articulated mechanical collectibles printed to order in high-grade PLA and PETG.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Manufacturing Workflow -->
  <section class="kg-process">
    <div class="kg-container">
      <h2 class="kg-section-title">Our Production Standard</h2>
      <div class="kg-steps">
        <div class="kg-step">
          <span class="kg-step-num">01</span>
          <h4>CAD & Model Slicing</h4>
          <p>Every geometry is optimized for structural integrity, minimal layer lines, and calibrated material flow.</p>
        </div>
        <div class="kg-step">
          <span class="kg-step-num">02</span>
          <h4>High-Speed Print Execution</h4>
          <p>Manufactured on high-speed enclosed build volumes with tight tolerances and strict temperature profiles.</p>
        </div>
        <div class="kg-step">
          <span class="kg-step-num">03</span>
          <h4>Post-Processing & Inspection</h4>
          <p>Support removal, surface refinement, assembly checks, and secure packaging ensure factory-grade delivery.</p>
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  .kg-about-wrapper {
    color: #1a1a1a;
    background-color: #ffffff;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  .kg-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .kg-hero {
    padding: 5rem 0 3.5rem;
    text-align: center;
    background: radial-gradient(circle at top, #f3f4f6 0%, #ffffff 70%);
  }
  .kg-badge {
    display: inline-block;
    background: #111827;
    color: #f9fafb;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    margin-bottom: 1.25rem;
  }
  .kg-title {
    font-size: 2.75rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-bottom: 1.25rem;
  }
  .kg-subtitle {
    font-size: 1.15rem;
    color: #4b5563;
    max-width: 720px;
    margin: 0 auto;
    line-height: 1.6;
  }
  .kg-pillars {
    padding: 3rem 0;
  }
  .kg-grid-3 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }
  .kg-card {
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 2.25rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .kg-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 24px -10px rgba(0,0,0,0.06);
  }
  .kg-icon {
    font-size: 2rem;
    margin-bottom: 1rem;
  }
  .kg-card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }
  .kg-card p {
    color: #6b7280;
    line-height: 1.5;
    font-size: 0.95rem;
  }
  .kg-process {
    padding: 4rem 0 5rem;
    border-top: 1px solid #f3f4f6;
  }
  .kg-section-title {
    text-align: center;
    font-size: 2rem;
    font-weight: 800;
    margin-bottom: 3rem;
  }
  .kg-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2.5rem;
  }
  .kg-step-num {
    display: inline-block;
    font-size: 1.5rem;
    font-weight: 900;
    color: #9ca3af;
    margin-bottom: 0.5rem;
  }
  .kg-step h4 {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .kg-step p {
    color: #6b7280;
    font-size: 0.9rem;
    line-height: 1.5;
  }
  @media (max-width: 768px) {
    .kg-title { font-size: 2rem; }
    .kg-hero { padding: 3.5rem 0 2rem; }
  }
</style>

{% schema %}
{
  "name": "Kinetic About Page",
  "settings": []
}
{% endschema %}
